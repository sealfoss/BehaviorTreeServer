# Publishes bt.<hostname>.local and bt-<hostname>.local for the gateway's address (design
# 14.3; the second name because Windows 11 does not look up three-part .local names, see
# docs/VERIFIED.md). Written by setup_system_service.sh from
# bt_server_bringup/systemd/bt-server-name.service.in.
# BT_ADDRESS is the server's LAN address, or "auto" to use the address of the default route
# when the unit starts.
[Unit]
Description=Behavior Tree Server: publish bt.%l.local and bt-%l.local
Wants=avahi-daemon.service network-online.target
After=avahi-daemon.service network-online.target
PartOf=bt-server.target

[Service]
Environment=BT_ADDRESS=@ADDRESS@
ExecStart=@PREFIX@/bin/bt-publish-name bt.%l.local bt-%l.local
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target bt-server.target
